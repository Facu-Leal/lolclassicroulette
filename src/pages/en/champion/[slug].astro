---
import ChampionDetail from "../../../components/ChampionDetail.astro";
import { allBuilds } from "../../../data/allBuilds.js";

export function getStaticPaths() {
  return allBuilds.map((champ) => ({ params: { slug: champ.slug }, props: { champ } }));
}

const { champ } = Astro.props;
---
<ChampionDetail champ={champ} lang="en" />
