---
import "../styles/global.css";
import { ui, rouletteUrl } from "../data/i18n.js";
import { site } from "../data/site.js";
import Ad from "../components/Ad.astro";

const {
  lang = "es",
  title,
  description,
  alt = {},
  active = "home",
  ogType = "website",
  jsonLd = null,
} = Astro.props;

const t = ui[lang];
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonicalPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonical = siteUrl + canonicalPath;
const fullTitle = title ? `${title} · ${t.siteName}` : `${t.siteName} — ${t.tagline}`;
const desc = description || t.metaDescription;
const ogImage = siteUrl + "/og-default.svg";
const ads = site.adsense;
const adsOn = ads.enabled && ads.client && !ads.client.includes("XXXX");
const kf = {
  es: { t: "Bloqueador detectado", p: "Los anuncios de este sitio no son intrusivos y ayudan a mantenerlo online. ¿Nos das una mano desactivándolo?", s: "¡Gracias por el apoyo!" },
  en: { t: "Ad blocker detected", p: "The ads on this site are non-intrusive and help keep it online. Would you consider turning it off for us?", s: "Thanks for the support!" },
}[lang] || { t: "Ad blocker detected", p: "The ads on this site are non-intrusive and help keep it online. Would you consider turning it off for us?", s: "Thanks for the support!" };
---
<!DOCTYPE html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://ddragon.leagueoflegends.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />

    {alt.es && <link rel="alternate" hreflang="es" href={siteUrl + alt.es} />}
    {alt.en && <link rel="alternate" hreflang="en" href={siteUrl + alt.en} />}
    {alt.es && <link rel="alternate" hreflang="x-default" href={siteUrl + alt.es} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={t.locale.replace("-", "_")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0a0e14" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {adsOn && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`/${lang}`} aria-label={t.siteName}>
          <span class="mark" aria-hidden="true"><svg viewBox="0 0 40 40" width="34" height="34" fill="none"><rect x="9" y="9" width="22" height="22" transform="rotate(45 20 20)" fill="#0a1622" stroke="#c8aa6e" stroke-width="1.2"/><rect x="13.5" y="13.5" width="13" height="13" transform="rotate(45 20 20)" stroke="#785a28" stroke-width="1"/><text x="20" y="21" text-anchor="middle" font-family="Cinzel, serif" font-size="9.5" font-weight="700" letter-spacing="0.5" fill="#f0e6d2">LC</text></svg></span>
          <span><b>LoL</b> <span class="brand-classic">Classic</span> Builds</span>
        </a>
        <nav class="nav">
          <a class={active === "home" ? "active" : ""} href={`/${lang}`}>{t.nav.home}</a>
          <a class={active === "roulette" ? "active" : ""} href={rouletteUrl(lang)}>{t.nav.roulette}</a>
          <a class={"hide-sm " + (active === "builds" ? "active" : "")} href={`/${lang}#builds`}>{t.nav.builds}</a>
          <span class="lang-switch">
            <a class={lang === "es" ? "active" : ""} href={alt.es || "/es"} hreflang="es">ES</a>
            <a class={lang === "en" ? "active" : ""} href={alt.en || "/en"} hreflang="en">EN</a>
          </span>
        </nav>
      </div>
    </header>

    <aside class="ad-rail left"><Ad slot="left" lang={lang} /></aside>
    <aside class="ad-rail right"><Ad slot="right" lang={lang} /></aside>

    <aside class="kf-rail left" aria-hidden="true"><div class="kf-box">
      <span class="kf-mark">LC</span>
      <h4>{kf.t}</h4>
      <p>{kf.p}</p>
      <small>{kf.s}</small>
    </div></aside>
    <aside class="kf-rail right" aria-hidden="true"><div class="kf-box">
      <span class="kf-mark">LC</span>
      <h4>{kf.t}</h4>
      <p>{kf.p}</p>
      <small>{kf.s}</small>
    </div></aside>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {t.siteName}</span>
        <span class="muted">{t.footer}</span>
      </div>
    </footer>
    <div id="adbait" class="adsbox ad-placement banner-ads sponsored pub_300x250" style="position:absolute;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none;"></div>
    <script is:inline>
      (function () {
        function check() {
          var b = document.getElementById("adbait");
          var cs = b ? getComputedStyle(b) : null;
          var blocked = !b || b.offsetHeight === 0 || b.offsetParent === null ||
            (cs && (cs.display === "none" || cs.visibility === "hidden"));
          if (blocked) {
            var rails = document.querySelectorAll(".ad-rail");
            for (var i = 0; i < rails.length; i++) rails[i].style.display = "none";
            var kf = document.querySelectorAll(".kf-rail");
            for (var j = 0; j < kf.length; j++) kf[j].classList.add("show");
          }
        }
        if (document.readyState === "complete") setTimeout(check, 300);
        else window.addEventListener("load", function () { setTimeout(check, 300); });
      })();
    </script>
  </body>
</html>
