---
// Promo de Eneba para pantallas chicas (<=900px), donde el .ad-rail lateral
// no se muestra (ese solo aparece con min-width: 1440px).
// variant="card" -> tarjeta inline (se usa una vez, ej. en el home).
// variant="bar"  -> franja fija abajo, descartable (se usa en el resto del sitio).
import { ENEBA_AFF } from "../data/site.js";

const { lang = "es", variant = "card" } = Astro.props;

const L = {
  es: { ad: "Publicidad", title: "RP y game keys al mejor precio", sub: "Skins, gift cards y juegos de PC con grandes descuentos.", cta: "Ver ofertas", close: "Cerrar" },
  en: { ad: "Advertisement", title: "Cheap RP & game keys", sub: "Skins, gift cards and PC games at big discounts.", cta: "Shop deals", close: "Close" },
}[lang] || { ad: "Publicidad", title: "RP y game keys al mejor precio", sub: "Skins, gift cards y juegos de PC con grandes descuentos.", cta: "Ver ofertas", close: "Cerrar" };
---
{variant === "card" ? (
  <a class="eneba-card" href={ENEBA_AFF} target="_blank" rel="sponsored noopener noreferrer" aria-label="Eneba">
    <span class="eneba-card-icon" aria-hidden="true">&#9876;</span>
    <span class="eneba-card-body">
      <span class="eneba-card-ph">{L.ad}</span>
      <span class="eneba-card-title">{L.title}</span>
      <span class="eneba-card-sub">{L.sub}</span>
    </span>
    <span class="eneba-card-cta">{L.cta} &rarr;</span>
  </a>
) : (
  <div class="eneba-bar" id="enebaBar">
    <a class="eneba-bar-link" href={ENEBA_AFF} target="_blank" rel="sponsored noopener noreferrer" aria-label="Eneba">
      <span class="eneba-bar-ph">{L.ad}</span>
      <span class="eneba-bar-title">{L.title}</span>
      <span class="eneba-bar-cta">{L.cta} &rarr;</span>
    </a>
    <button class="eneba-bar-close" id="enebaBarClose" aria-label={L.close}>&times;</button>
  </div>
)}

{variant === "bar" && (
  <script is:inline>
    (function () {
      var KEY = "enebaBarDismissed";
      var bar = document.getElementById("enebaBar");
      if (!bar) return;
      if (localStorage.getItem(KEY) === "1") { bar.style.display = "none"; return; }
      var btn = document.getElementById("enebaBarClose");
      if (btn) btn.addEventListener("click", function () {
        bar.style.display = "none";
        try { localStorage.setItem(KEY, "1"); } catch (e) {}
      });
    })();
  </script>
)}

<style>
  /* ---- Tarjeta inline (mobile/tablet) ---- */
  .eneba-card {
    display: none;
    align-items: center; gap: 14px; padding: 14px 16px; margin-top: 16px;
    text-decoration: none; border: 1px solid var(--gold-edge);
    background: radial-gradient(180px 100px at 0% 0%, rgba(10,200,185,.06), transparent 70%),
      linear-gradient(180deg, #0c1f2b, #08131c);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.45);
  }
  .eneba-card:hover { border-color: var(--gold-dim); }
  .eneba-card-icon { flex: 0 0 auto; font-size: 1.6rem; }
  .eneba-card-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .eneba-card-ph { font-size: .6rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gold-dim); font-family: "Cinzel", serif; }
  .eneba-card-title { font-family: "Cinzel", serif; font-size: .92rem; color: var(--parchment); line-height: 1.25; }
  .eneba-card-sub { font-size: .74rem; color: var(--text-dim); line-height: 1.35; }
  .eneba-card-cta {
    flex: 0 0 auto; margin-left: auto; white-space: nowrap; font-family: "Cinzel", serif;
    font-size: .7rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    color: #10141c; padding: 8px 10px;
    background: linear-gradient(180deg, #f0e6d2, #c8aa6e 55%, #c89b3c);
    border: 1px solid var(--gold);
  }

  /* ---- Barra fija abajo (mobile/tablet, resto del sitio) ---- */
  .eneba-bar {
    display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    align-items: center; gap: 8px; padding: 10px 12px;
    background: linear-gradient(180deg, rgba(4,12,20,.97), rgba(1,10,19,.97));
    border-top: 1px solid var(--gold-edge); box-shadow: 0 -6px 20px rgba(0,0,0,.5);
  }
  .eneba-bar-link { flex: 1 1 auto; display: flex; align-items: center; gap: 8px; min-width: 0; text-decoration: none; }
  .eneba-bar-ph { flex: 0 0 auto; font-size: .55rem; letter-spacing: 1.2px; text-transform: uppercase; color: var(--gold-dim); font-family: "Cinzel", serif; }
  .eneba-bar-title { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .78rem; color: var(--parchment); }
  .eneba-bar-cta {
    flex: 0 0 auto; white-space: nowrap; font-family: "Cinzel", serif;
    font-size: .66rem; font-weight: 700; letter-spacing: .5px; text-transform: uppercase;
    color: #10141c; padding: 6px 9px;
    background: linear-gradient(180deg, #f0e6d2, #c8aa6e 55%, #c89b3c);
    border: 1px solid var(--gold);
  }
  .eneba-bar-close {
    flex: 0 0 auto; width: 28px; height: 28px; display: grid; place-items: center;
    background: transparent; border: 1px solid var(--hair); color: var(--text-dim);
    font-size: 1.1rem; line-height: 1; cursor: pointer;
  }
  .eneba-bar-close:hover { color: var(--gold); border-color: var(--gold-dim); }

  @media (max-width: 900px) {
    .eneba-card { display: flex; }
    .eneba-bar { display: flex; }
  }
</style>
